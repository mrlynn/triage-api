# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Overrides the model chosen in src/config.ts.
# TRIAGE_MODEL=claude-sonnet-5

# Optional. Comma-separated bearer tokens for /v1/*. Unset = open (dev only).
# API_TOKENS=dev-token-1,dev-token-2

PORT=8787

# --- Store: mongodb ---------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=triage_api

# --- Ingest secrets. Each configured source REQUIRES its secret or it refuses
#     every request. Fail closed is the point; do not "temporarily" unset one.
# GENERIC_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=
# ZENDESK_WEBHOOK_SECRET=

# --- Sinks (all optional; with none set the service is advisory-only) -------
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# OUTBOUND_WEBHOOK_URL=
# OUTBOUND_WEBHOOK_SECRET=
