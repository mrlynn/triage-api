# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Overrides the model chosen in src/config.ts.
# TRIAGE_MODEL=claude-sonnet-5

# Optional. Comma-separated bearer tokens for /v1/*. Unset = open (dev only).
# API_TOKENS=dev-token-1,dev-token-2

PORT=8787

# --- Store: mongodb ---------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=triage_api

# --- Ingest secrets. Each configured source REQUIRES its secret or it refuses
#     every request. Fail closed is the point; do not "temporarily" unset one.
# GENERIC_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=
# ZENDESK_WEBHOOK_SECRET=
# Chatwoot lets you save a webhook with NO secret, in which case it sends the
# payload unsigned and this source refuses every request. Set one on the webhook.
# CHATWOOT_WEBHOOK_SECRET=
# Zammad's signature token is optional in its UI; leave it blank and Zammad
# sends the payload unsigned and this source refuses every request.
# ZAMMAD_WEBHOOK_SECRET=

# --- Sinks (all optional; with none set the service is advisory-only) -------
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# OUTBOUND_WEBHOOK_URL=
# OUTBOUND_WEBHOOK_SECRET=
# Chatwoot. The base URL is used by BOTH the source (reviewer deep links) and
# the sink (API calls). Issue the access token to a bot/automation user — every
# label, priority change and note is attributed to whoever owns it.
# CHATWOOT_BASE_URL=https://app.chatwoot.com
# CHATWOOT_API_ACCESS_TOKEN=
# CHATWOOT_ACCOUNT_ID=1
# Zammad. ZAMMAD_URL is used by BOTH the source (reviewer deep links) and the
# sink (API calls). The instance setting "API token access" must be enabled,
# and the token's user needs agent rights on the groups you write to.
# ZAMMAD_URL=https://help.example.com
# ZAMMAD_TOKEN=
